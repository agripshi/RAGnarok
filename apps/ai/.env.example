APP_ENV=local
AI_HOST=0.0.0.0
AI_PORT=8001

# Internal auth — must match apps/api
AI_BACKEND_INTERNAL_TOKEN=dev-internal-token

# Vector DB
VECTOR_DB=qdrant
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=hr_documents
CHROMA_PERSIST_DIR=./.chroma

# LLM provider
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.0

# Embeddings
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# RAG
TOP_K=6
SIMILARITY_THRESHOLD=0.72
CHUNK_SIZE=900
CHUNK_OVERLAP=120
MAX_CONTEXT_CHUNKS=6
MAX_RECENT_MESSAGES=6

# Source scope — must match apps/api TEAM_ID / HR_PRIVATE_CHANNEL_ID
DEFAULT_TEAM_ID=demo-team-id
DEFAULT_CHANNEL_ID=demo-hr-channel-id
HR_DOCS_LOCAL_DIR=../../data/hr-docs
