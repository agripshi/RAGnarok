APP_ENV=local
AI_HOST=0.0.0.0
AI_PORT=8001

# Internal auth — must match apps/api
AI_BACKEND_INTERNAL_TOKEN=dev-internal-token

# Vector DB: memory (fast mock, no local embedding models) | chroma | qdrant
VECTOR_DB=memory
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=hr_documents
CHROMA_PERSIST_DIR=./.chroma

# Cloud LLM — OpenAI or Azure OpenAI compatible API (no local LLM)
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.0
# true = template mock grounded in retrieved docs; false + LLM_API_KEY = real cloud API
LLM_MOCK_ENABLED=true

# Cloud embeddings — only when VECTOR_DB=chroma or qdrant with cloud embeddings
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# RAG
TOP_K=6
SIMILARITY_THRESHOLD=0.15
CHUNK_SIZE=900
CHUNK_OVERLAP=120
MAX_CONTEXT_CHUNKS=6

# Source scope — must match apps/api TEAM_ID / HR_PRIVATE_CHANNEL_ID
# Local-folder demo mapped to the "Documents - Engineering Albania" Teams channel
DEFAULT_TEAM_ID=1531e68a-4716-43aa-bc3b-41b11451cbbb
DEFAULT_CHANNEL_ID=19:11b56c75623d48ac828e2797373cacae@thread.tacv2
HR_DOCS_LOCAL_DIR=../../data/hr-docs
